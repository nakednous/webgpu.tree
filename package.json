{
  "name": "webgpu.tree",
  "version": "0.0.4",
  "description": "webgpu.tree — the WebGPU twin of webgl.tree: @nakednous/tree + @nakednous/host on raw WebGPU, its composites on @nakednous/idiom.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "test": "node --test test/",
    "build": "rollup -c",
    "docs": "node tools/docs/index.js",
    "clean": "rm -rf dist site",
    "rebuild": "npm run clean && npm run build",
    "reset": "rm -rf node_modules dist package-lock.json && npm install",
    "link:core": "npm install --no-save file:../tree file:../host file:../idiom",
    "unlink:core": "npm unlink --no-save @nakednous/tree @nakednous/host @nakednous/idiom && npm install @nakednous/tree @nakednous/host @nakednous/idiom",
    "prepublishOnly": "npm run rebuild",
    "postpublish": "npm run link:core"
  },
  "keywords": [
    "webgpu",
    "webgpu-utils",
    "graphics",
    "tree",
    "shader",
    "gizmo",
    "picking",
    "camera",
    "manipulator"
  ],
  "author": "Jean Pierre Charalambos <nakednous@gmail.com>",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nakednous/webgpu.tree.git"
  },
  "peerDependencies": {
    "webgpu-utils": "^2.1.1"
  },
  "dependencies": {
    "@nakednous/host": "^0.0.12",
    "@nakednous/idiom": "^0.0.10",
    "@nakednous/tree": "^0.0.34"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "comment-parser": "^1.4.9",
    "marked": "^18.1.1",
    "rollup": "^4.63.1",
    "webgpu-utils": "^2.1.1"
  }
}
